# Awamir Plus production Docker environment template.
# Copy to .env.production on the production host and replace every placeholder.
# Do not commit .env.production or any real secret.

NODE_ENV=production
PORT=3000

# Bind API to localhost by default so a host reverse proxy or load balancer can
# terminate TLS. Use 0.0.0.0 only behind a firewall/private load balancer.
API_BIND_ADDRESS=127.0.0.1

# Optional image tags for registry-based deployment.
AWAMIR_API_IMAGE=registry.example.com/awamir-plus/api:replace-with-release-tag
AWAMIR_WORKER_IMAGE=registry.example.com/awamir-plus/worker:replace-with-release-tag

POSTGRES_DB=awamir_plus
POSTGRES_USER=awamir
POSTGRES_PASSWORD=replace-with-strong-production-postgres-password

DATABASE_URL=postgresql://awamir:replace-with-strong-production-postgres-password@postgres:5432/awamir_plus?schema=public
REDIS_URL=redis://redis:6379/0

AUTH_JWT_SECRET=replace-with-long-random-production-jwt-secret
AUTH_JWT_EXPIRES_IN_SECONDS=28800
AUTH_JWT_ISSUER=awamir-plus
AUTH_JWT_AUDIENCE=awamir-plus-mobile
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Optional. Defaults to AUTH_JWT_SECRET when unset.
AUTH_REFRESH_TOKEN_SECRET=
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_BCRYPT_COST=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_ADMIN_RATE_LIMIT_MAX=30

ERPNEXT_BASE_URL=https://erpnext-production.example.com
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
ERPNEXT_COMPANY=Awamir Plus
ERPNEXT_TIMEOUT_MS=5000
ERPNEXT_HEALTH_ENABLED=true
ERPNEXT_WORKER_ENABLED=true

ERPNEXT_DEFAULT_CUSTOMER=replace-with-default-customer-if-needed
ERPNEXT_DEFAULT_WAREHOUSE=replace-with-default-warehouse
ERPNEXT_RECEIVABLE_ACCOUNT=replace-with-receivable-account
ERPNEXT_INCOME_ACCOUNT=replace-with-income-account
ERPNEXT_CASH_ACCOUNT=replace-with-cash-account
ERPNEXT_CARD_ACCOUNT=replace-with-card-account
ERPNEXT_TRANSFER_ACCOUNT=replace-with-transfer-account
ERPNEXT_ONLINE_ACCOUNT=replace-with-online-account
ERPNEXT_CREDIT_ACCOUNT=replace-with-credit-account

# CORS values are consumed by the backend when enabled by the deployment.
CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=false
TRUST_PROXY=1

# Container log rotation.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Redis AOF safety/performance tradeoff. Keep everysec for normal production.
REDIS_APPENDFSYNC=everysec

# Optional structured logging controls.
LOG_LEVEL=info
