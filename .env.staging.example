# Awamir Plus staging Docker environment template.
# Copy to .env.staging and replace every placeholder before deployment.
# Do not commit .env.staging.

NODE_ENV=staging
PORT=3000
STAGING_API_DOMAIN=api-staging.example.com
CADDY_EMAIL=ops@example.com
API_BIND_ADDRESS=127.0.0.1

AWAMIR_API_IMAGE=ghcr.io/r87823/awamir-plus-api:staging
AWAMIR_WORKER_IMAGE=ghcr.io/r87823/awamir-plus-worker:staging

POSTGRES_DB=awamir_plus
POSTGRES_USER=awamir
POSTGRES_PASSWORD=replace-with-strong-postgres-password

DATABASE_URL=postgresql://awamir:replace-with-strong-postgres-password@postgres:5432/awamir_plus?schema=public
REDIS_URL=redis://redis:6379/0

AUTH_JWT_SECRET=replace-with-long-random-jwt-secret

ERPNEXT_BASE_URL=https://erpnext-staging.example.com
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
ERPNEXT_COMPANY=Awamir Plus
ERPNEXT_TIMEOUT_MS=5000
ERPNEXT_HEALTH_ENABLED=true
ERPNEXT_WORKER_ENABLED=true

ERPNEXT_DEFAULT_CUSTOMER=replace-with-default-customer-if-needed
ERPNEXT_DEFAULT_WAREHOUSE=replace-with-default-warehouse
ERPNEXT_RECEIVABLE_ACCOUNT=replace-with-receivable-account
ERPNEXT_INCOME_ACCOUNT=replace-with-income-account
ERPNEXT_CASH_ACCOUNT=replace-with-cash-account
ERPNEXT_CARD_ACCOUNT=replace-with-card-account
ERPNEXT_TRANSFER_ACCOUNT=replace-with-transfer-account
ERPNEXT_ONLINE_ACCOUNT=replace-with-online-account
ERPNEXT_CREDIT_ACCOUNT=replace-with-credit-account

# R19-T02 real ERPNext staging verification.
# These values are for the Awamir backend smoke command only; do not put ERPNext
# secrets here unless this file has been copied to an untracked .env file.
AWAMIR_API_BASE_URL=https://api-staging.example.com
AWAMIR_VERIFY_USERNAME=admin
AWAMIR_VERIFY_PASSWORD=demo
AWAMIR_VERIFY_BRANCH_CODE=RIYADH
AWAMIR_VERIFY_PRODUCT_CODE=FATAYER_SPINACH
AWAMIR_VERIFY_PAYMENT_METHOD=CASH
AWAMIR_VERIFY_ALLOW_STAGING_STATE_PREP=true
