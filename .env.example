# Awamir Plus local/default environment template.
# Copy to .env for local shell usage or to .env.staging for docker-compose.prod.yml.
# Do not commit real secrets.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://awamir:awamir_password@localhost:55432/awamir_plus?schema=public
REDIS_URL=redis://localhost:6379/0

AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=28800
AUTH_JWT_ISSUER=awamir-plus
AUTH_JWT_AUDIENCE=awamir-plus-mobile
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Optional. Defaults to AUTH_JWT_SECRET when unset.
AUTH_REFRESH_TOKEN_SECRET=
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_BCRYPT_COST=12
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=*
CORS_CREDENTIALS=false
TRUST_PROXY=

ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=replace-with-erpnext-api-key
ERPNEXT_API_SECRET=replace-with-erpnext-api-secret
ERPNEXT_COMPANY=Awamir Plus

ERPNEXT_WORKER_ENABLED=false
ERPNEXT_HEALTH_ENABLED=false
ERPNEXT_TIMEOUT_MS=5000

POSTGRES_DB=awamir_plus
POSTGRES_USER=awamir
POSTGRES_PASSWORD=replace-with-postgres-password
