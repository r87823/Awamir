{
  "name": "awamir-plus",
  "version": "0.0.0",
  "private": true,
  "description": "Awamir Plus monorepo",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "pnpm -r --if-present lint && pnpm mobile:analyze",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm mobile:test",
    "test:e2e": "pnpm --filter @awamir/api test:e2e",
    "format": "pnpm -r --if-present format && dart format apps/mobile",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "api:dev": "pnpm --filter @awamir/api start:dev",
    "prisma:generate": "pnpm --filter @awamir/api prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @awamir/api prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @awamir/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @awamir/api db:seed",
    "docker:build": "docker build -f apps/api/Dockerfile --target api -t awamir-plus-api:local .",
    "docker:worker:build": "docker build -f apps/api/Dockerfile --target worker -t awamir-plus-worker:local .",
    "docker:prod:up": "docker compose --env-file .env.staging -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env.staging -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
